# Copy to .env and adjust. Every value here is an example.
# The demo needs NO values at all: `npm run demo` works with this file absent.

# --- Safety ---------------------------------------------------------------
# Demo mode (default) uses local mock adapters and blocks all network
# requests except the optional AI provider.
DEMO_MODE=true
# Live publishing needs ALL of: DEMO_MODE=false, PUBLISH_MODE=wordpress and
# LIVE_PUBLISH_CONFIRM=I_UNDERSTAND_THIS_PUBLISHES_TO_A_REAL_SITE
PUBLISH_MODE=mock
LIVE_PUBLISH_CONFIRM=

# --- Site -----------------------------------------------------------------
SITE_NAME=Example Jobs Board
SITE_URL=https://jobs.example.com
TARGET_COUNTRY=Country A
TIMEZONE_OFFSET_HOURS=0

# --- AI (optional) --------------------------------------------------------
# mock = offline heuristics (default). groq = real LLM via the Groq API.
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_MIN_GAP_MS=2000
AI_COOLDOWN_MS=60000

# --- Pipeline limits ------------------------------------------------------
JOBS_DAILY_TARGET=20
JOBS_RUN_CAP=8
INTER_CANDIDATE_DELAY_MS=0
MAX_FAILURES_BEFORE_STUCK=3
# Failed AI screening attempts (errors, malformed verdicts) before a job is
# moved to the manual-review queue. Such jobs are never published unscreened.
MAX_AI_FAILURES_BEFORE_REVIEW=3
FINGERPRINT_WINDOW_DAYS=7

# --- Site lists -----------------------------------------------------------
# Known cities and well-known employers. Defaults to config/site.example.json
SITE_CONFIG=

# --- Live publishing only (opt-in, unused by the demo): WordPress ----------
WP_BASE_URL=https://your-site.example/wp-json/wp/v2
WP_USERNAME=
WP_APP_PASSWORD=
# Site-specific taxonomy term IDs, as JSON
WP_JOB_TYPE_TERMS={"entry-level":0,"internship":0,"executive":0,"full-time":0,"part-time":0}
WP_CATEGORY_TERMS={"local":0,"global":0}

# --- Live publishing only (opt-in, unused by the demo): Google Indexing ----
# Path to a service-account JSON key file kept OUTSIDE the repository.
GOOGLE_INDEXING_KEY_PATH=
